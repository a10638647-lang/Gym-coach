<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>AI Gym Coach</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;800&display=swap">
<style>
:root{--bg:#eef1f4;--card:#fff;--tx:#12161c;--mu:#5b6470;--ac:#0b8f63;--acb:#d7f5e8;--wa:#b36b00;--wab:#fff0d1;--er:#c4302a;--erb:#fde0de;--bd:#dde2e8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0c1014;--card:#161b22;--tx:#eef2f6;--mu:#98a3b0;--ac:#35e2a3;--acb:#12372b;--wa:#ffb83d;--wab:#3a2d10;--er:#ff6a62;--erb:#40191a;--bd:#262d38}}
:root[data-theme="dark"]{--bg:#0c1014;--card:#161b22;--tx:#eef2f6;--mu:#98a3b0;--ac:#35e2a3;--acb:#12372b;--wa:#ffb83d;--wab:#3a2d10;--er:#ff6a62;--erb:#40191a;--bd:#262d38}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:'Tajawal',system-ui,sans-serif;line-height:1.5}
.w{max-width:560px;margin:0 auto;padding:14px 14px 40px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
h1{font-size:20px;margin:0;font-weight:800;letter-spacing:.2px}
.chip{font-size:13px;font-weight:700;padding:4px 12px;border-radius:99px;background:var(--bd);color:var(--mu)}
.chip.g{background:var(--acb);color:var(--ac)}.chip.w{background:var(--wab);color:var(--wa)}.chip.e{background:var(--erb);color:var(--er)}
.cv{position:relative;background:#0a0d11;border-radius:14px;overflow:hidden;aspect-ratio:4/3}
canvas{width:100%;height:100%;display:block}
.ov{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#cfd6de;text-align:center;padding:24px;font-size:15px}
video{display:none}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-top:10px}
.nm{font-size:24px;font-weight:800;line-height:1.2}.en{color:var(--mu);font-size:15px;direction:ltr;text-align:right}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;align-items:center}
.tags b{font-size:13px;color:var(--mu);font-weight:700}
.t{font-size:13px;padding:2px 10px;border-radius:6px;background:var(--bd)}.t.p{background:var(--acb);color:var(--ac);font-weight:700}
.st{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
.st div{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:10px;text-align:center}
.st span{display:block;font-size:30px;font-weight:800;line-height:1.1}.st small{color:var(--mu);font-size:13px}
.bar{height:8px;border-radius:5px;background:var(--bd);margin-top:6px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:var(--ac);transition:width .15s}
.ang{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;text-align:center;font-size:13px;color:var(--mu)}
.ang b{display:block;font-size:18px;color:var(--tx)}
#fb{font-size:16px;font-weight:700;border-radius:12px;padding:12px 14px;margin-top:10px;background:var(--bd)}
#fb.g{background:var(--acb);color:var(--ac)}#fb.w{background:var(--wab);color:var(--wa)}#fb.e{background:var(--erb);color:var(--er)}
.sim{padding:8px 0;border-top:1px solid var(--bd)}.sim:first-of-type{border:0}
.sim .r{display:flex;justify-content:space-between;font-weight:700}
.btns{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
button{font:inherit;font-weight:700;border:1px solid var(--bd);background:var(--card);color:var(--tx);padding:11px 16px;border-radius:10px;flex:1;min-height:44px;cursor:pointer}
button.pr{background:var(--ac);color:#04281c;border-color:var(--ac)}
button:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
.nt{color:var(--mu);font-size:13px;margin-top:12px}
[hidden]{display:none!important}
</style></head><body><div class="w">
<header><h1>AI Gym Coach</h1><span class="chip" id="chip">بانتظار الكاميرا</span></header>
<div class="cv"><canvas id="cv" width="640" height="480"></canvas><div class="ov" id="ov">شغّل الكاميرا وقف بحيث يظهر جسمك كاملًا من الجانب، أو جرّب الوضع التجريبي.</div></div>
<video id="vd" playsinline muted></video>
<div class="btns"><button class="pr" id="bc">تشغيل الكاميرا</button><button id="bd">وضع تجريبي</button><button id="br">تصفير</button></div>
<div class="card" id="exc"></div>
<div class="st"><div><span id="rp">0</span><small>التكرارات</small></div><div><span id="sv">0</span><small>جولات مكتملة</small></div><div><span id="rom">–</span><small>المدى الحركي (آخر تكرار)</small></div></div>
<div class="card"><div class="ang"><div><b id="a1">–</b>الركبة</div><div><b id="a2">–</b>الكوع</div><div><b id="a3">–</b>الورك</div><div><b id="a4">–</b>ميل الجذع</div></div>
<div class="bar"><i id="lb"></i></div></div>
<div id="fb">ابدأ التمرين وسأحلل حركتك.</div>
<div class="card" id="simc" hidden><div style="font-weight:800;margin-bottom:4px" id="simt"></div><div id="siml"></div></div>
<p class="nt">للدقة: صوّر من الجانب، وأظهر الجسم كاملًا من الرأس للقدمين، وبإضاءة جيدة. لا يُحتسب أي تكرار قبل تأكيد التمرين، ولا يُحتسب التكرار الناقص.</p>
</div>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/pose@0.5.1675469404/pose.js" crossorigin="anonymous"></script>
<script>
const $=i=>document.getElementById(i),cv=$('cv'),cx=cv.getContext('2d'),vd=$('vd');
const EX={
squat:{ar:'سكوات',en:'Squat',p:['الفخذ الأمامية (رباعية)','الألوية'],s:['الفخذ الخلفية','عضلات الجذع','السمانة']},
pushup:{ar:'ضغط',en:'Push-up',p:['الصدر','الترايسبس'],s:['الكتف الأمامي','عضلات الجذع']},
curl:{ar:'تمرين البايسبس',en:'Biceps Curl',p:['البايسبس'],s:['العضلة العضدية','عضلات الساعد']},
press:{ar:'ضغط الكتف',en:'Shoulder Press',p:['الكتف (الدالية)','الترايسبس'],s:['الترابيس العلوية','عضلات الجذع']},
hinge:{ar:'مفصلة الورك / الرفعة الميتة',en:'Hip Hinge / Deadlift',p:['الألوية','الفخذ الخلفية'],s:['أسفل الظهر','الترابيس']}};
const CFG={
squat:{a:'knee',s:1,from:150,valid:115,full:90,back:156,tip:'انزل أعمق حتى تصل الركبة إلى 115° أو أقل'},
pushup:{a:'elbow',s:1,from:145,valid:100,full:75,back:155,tip:'انزل بالصدر أكثر حتى ينثني الكوع إلى 100° أو أقل'},
curl:{a:'elbow',s:1,from:130,valid:60,full:40,back:140,tip:'اثنِ الكوع أكثر (60° أو أقل) ثم افرده بالكامل'},
press:{a:'elbow',s:-1,from:-105,valid:-150,full:-170,back:-100,tip:'ادفع حتى يمتد الكوع بالكامل فوق الرأس'},
hinge:{a:'hip',s:1,from:150,valid:120,full:85,back:158,tip:'حرّك الورك للخلف أكثر (زاوية الورك 120° أو أقل)'}};
const ang=(a,b,c)=>{const x=a.x-b.x,y=a.y-b.y,u=c.x-b.x,v=c.y-b.y;return Math.acos(Math.max(-1,Math.min(1,(x*u+y*v)/((Math.hypot(x,y)*Math.hypot(u,v))||1e-6))))*180/Math.PI};
const cl=(x,a,b)=>Math.max(a,Math.min(b,x)),sat=(x,a)=>cl(x/a,0,1);
let buf=[],lock=null,cand=null,candT=0,lowT=0,reps=0,sets=0,phase=0,ext=0,lastRom=null,lastRepT=0,cueExt=[],liveRom=0,lastMove=0,mode=null,stream=null,pose=null,st='idle',rk=[],fbT=0;

function score(w){
 const R=k=>{const v=w.map(f=>f[k]);return Math.max(...v)-Math.min(...v)};
 const flat=w.filter(f=>f.flat).length/w.length,wUp=w.filter(f=>f.wUp).length/w.length;
 const kR=R('knee'),eR=R('elbow'),hR=R('hip'),up=1-flat,S={};
 S.mv=Math.max(kR,eR,hR);
 S.squat=up*sat(kR,60)*(1-.4*sat(eR,60));
 S.hinge=up*sat(hR,50)*Math.max(0,1-kR/50);
 S.pushup=flat*sat(eR,50);
 const arm=up*sat(eR,60)*(1-sat(kR,40))*(1-sat(hR,40));
 S.curl=arm*(1-sat(wUp,.2));
 S.press=arm*sat(wUp,.2);
 return S}

function cues(f){const c=[];
 if(lock==='squat'&&f.torso>55)c.push('تميل للأمام كثيرًا — ارفع صدرك');
 if(lock==='pushup'&&f.line<160)c.push('حافظ على استقامة الجسم من الكتف حتى الكاحل');
 if(lock==='curl'&&f.torso>15)c.push('لا تتأرجح بجذعك — ثبّت الكتف');
 if(lock==='press'&&f.torso>20)c.push('لا تقوّس ظهرك للخلف');
 if(lock==='hinge'&&f.knee<125)c.push('ثنيت الركبتين كثيرًا — حرّك الورك للخلف أكثر');
 return c}
function fb(t,k){$('fb').textContent=t;$('fb').className=k||''}
function endSet(){if(reps>0){sets++;reps=0;lastRom=null;fb('انتهت الجولة '+sets+' — استرح ثم ابدأ الجولة التالية','g')}phase=0}

function proc(lm,asp,t){
 const P=lm.map(p=>({x:p.x*asp,y:p.y,v:p.visibility??1}));
 const L=[11,13,15,23,25,27],Rr=[12,14,16,24,26,28],vs=a=>a.reduce((s,i)=>s+P[i].v,0);
 const idx=vs(L)>=vs(Rr)?L:Rr,[sh,el,wr,hp,kn,an]=idx.map(i=>P[i]);
 if(vs(idx)/6<.5){fb('ابتعد قليلًا ليظهر جسمك كاملًا (يفضّل من الجانب)','w');st='none';ui();return}
 const raw={knee:ang(hp,kn,an),elbow:ang(sh,el,wr),hip:ang(sh,hp,kn),line:ang(sh,hp,an),torso:Math.atan2(Math.abs(sh.x-hp.x),hp.y-sh.y)*180/Math.PI};
 const pv=buf[buf.length-1],f={t};
 for(const k in raw)f[k]=pv?pv[k]*.5+raw[k]*.5:raw[k];
 f.flat=f.torso>55&&f.line>150;f.wUp=wr.y<sh.y-.08;
 buf.push(f);while(buf.length&&t-buf[0].t>3500)buf.shift();
 if(buf.length>12&&t-buf[0].t>1200){
  const S=score(buf);rk=Object.keys(EX).map(k=>[k,S[k]]).sort((a,b)=>b[1]-a[1]);
  const [k1,s1]=rk[0],s2=rk[1][1];
  if(S.mv>=14)lastMove=t;
  if(lock){
   if(S.mv<14){st='rest';if(t-lastMove>20000){endSet();lock=null;cand=null}}
   else{st='locked';if(S[lock]<.4){if(!lowT)lowT=t;if(t-lowT>2000){endSet();lock=null;cand=null;lowT=0}}else lowT=0}
   if(lock&&reps>0&&t-lastRepT>12000&&S.mv<14)endSet();
  }
  if(!lock){
   if(S.mv<14){st='idle';cand=null}
   else if(s1>=.7&&s1-s2>=.15){
    st='ambiguous';
    if(cand!==k1){cand=k1;candT=t}else if(t-candT>1200){lock=k1;reps=0;phase=0;lastMove=t;st='locked'}
   }else{cand=null;st=s1>=.7?'ambiguous':s1>=.45?'probable':s1>=.2?'wrong':'none'}
  }
 }
 if(lock){
  const c=CFG[lock],m=c.s*f[c.a];
  liveRom=cl((c.back-m)/(c.back-c.full),0,1);
  if(phase===0){if(m<c.from){phase=1;ext=m;cueExt=cues(f)}}
  else{
   if(m<ext){ext=m;cueExt=cues(f)}
   if(m>c.back){phase=0;lastRom=Math.round(cl((c.back-ext)/(c.back-c.full),0,1)*100);
    if(ext<=c.valid){reps++;lastRepT=t;cueExt.length?fb(cueExt[0],'w'):fb('تكرار صحيح ✓ ('+reps+')','g')}
    else fb('تكرار ناقص ولم يُحتسب — '+c.tip,'e')}
  }
  if(phase===1&&t-fbT>1200){const q=cues(f);if(q.length){fb(q[0],'w');fbT=t}}
 }
 ui(f)}

function mus(k){const e=EX[k];return '<div class="tags"><b>الأساسية:</b>'+e.p.map(x=>'<span class="t p">'+x+'</span>').join('')+'</div><div class="tags"><b>الثانوية:</b>'+e.s.map(x=>'<span class="t">'+x+'</span>').join('')+'</div>'}
let lastKey='';
function ui(f){
 if(f){$('a1').textContent=Math.round(f.knee)+'°';$('a2').textContent=Math.round(f.elbow)+'°';$('a3').textContent=Math.round(f.hip)+'°';$('a4').textContent=Math.round(f.torso)+'°'}
 $('rp').textContent=reps;$('sv').textContent=sets;$('rom').textContent=lastRom==null?'–':lastRom+'%';$('lb').style.width=(lock?liveRom*100:0)+'%';
 const top=rk[0]||['',0],pc=Math.round(top[1]*100);
 const M={idle:['بانتظار الحركة','' ],rest:['استراحة','w'],none:['بانتظار الحركة',''],locked:['تم التعرف ✓','g'],ambiguous:['غير مؤكد','w'],probable:['غير مؤكد','w'],wrong:['حركة غير مطابقة','e']};
 const m=M[st]||M.idle;$('chip').textContent=m[0];$('chip').className='chip '+m[1];
 const key=[st,lock,top[0],pc>>3].join();if(key===lastKey)return;lastKey=key;
 let h='';
 if(lock){const e=EX[lock];h='<div class="nm">'+e.ar+'</div><div class="en">'+e.en+' · تطابق '+pc+'%</div>'+mus(lock)}
 else if(st==='probable')h='<div class="nm">ربما: '+EX[top[0]].ar+'</div><div class="en">'+EX[top[0]].en+'</div><div class="nt">الحركة تشبهه لكنها غير مكتملة أو بوضعية غير صحيحة، لذلك لن أحتسب تكرارات. أكمل المدى الحركي بشكل صحيح للتأكيد.</div>';
 else if(st==='ambiguous')h='<div class="nm">قريب من أكثر من تمرين</div><div class="nt">لم أستطع الحسم بثقة. أوضح الحركة أو غيّر زاوية الكاميرا.</div>';
 else if(st==='wrong')h='<div class="nm">الحركة لا تطابق التمرين المتوقع</div><div class="nt">لا أعرض نتيجة غير مؤكدة على أنها صحيحة. هذه أقرب التمارين لما أراه:</div>';
 else h='<div class="nm">لم يُحدَّد تمرين بعد</div><div class="nt">ابدأ بالتمرين وسأتعرف عليه تلقائيًا خلال ثوانٍ.</div>';
 $('exc').innerHTML=h;
 const sim=!lock&&['ambiguous','probable','wrong'].includes(st)?rk.filter(r=>r[1]>=.2).slice(0,3):[];
 $('simc').hidden=!sim.length;
 if(sim.length){$('simt').textContent='أقرب التمارين المشابهة';$('siml').innerHTML=sim.map(r=>{const e=EX[r[0]];return '<div class="sim"><div class="r"><span>'+e.ar+' <small dir="ltr">'+e.en+'</small></span><span>'+Math.round(r[1]*100)+'%</span></div>'+mus(r[0])+'</div>'}).join('')}
}

const CONN=[[11,12],[11,13],[13,15],[12,14],[14,16],[11,23],[12,24],[23,24],[23,25],[25,27],[24,26],[26,28]];
function draw(lm,src){
 if(src){cv.width=src.videoWidth||640;cv.height=src.videoHeight||480;cx.drawImage(src,0,0,cv.width,cv.height)}
 else{cx.fillStyle='#0a0d11';cx.fillRect(0,0,cv.width,cv.height)}
 if(!lm)return;const W=cv.width,H=cv.height;
 cx.lineWidth=4;cx.strokeStyle='#35e2a3';cx.lineCap='round';
 CONN.forEach(([a,b])=>{cx.beginPath();cx.moveTo(lm[a].x*W,lm[a].y*H);cx.lineTo(lm[b].x*W,lm[b].y*H);cx.stroke()});
 cx.fillStyle='#fff';[11,12,13,14,15,16,23,24,25,26,27,28].forEach(i=>{cx.beginPath();cx.arc(lm[i].x*W,lm[i].y*H,5,0,7);cx.fill()})}

function demoLM(t){
 const T=t/1000%32;let k=175,e=170,lean=5,s;
 if(T<12){s=.5-.5*Math.cos(2*Math.PI*T/2.4);k=175-85*s;lean=8+30*s}
 else if(T<20){s=.5-.5*Math.cos(2*Math.PI*T/2.2);e=165-125*s;lean=4}
 else{s=.5-.5*Math.cos(2*Math.PI*T/2.6);k=175-35*s;e=165-55*s;lean=6+15*s}
 const r=Math.PI/180,D=a=>[Math.sin(a),-Math.cos(a)],add=(p,d,l)=>[p[0]+d[0]*l,p[1]+d[1]*l];
 const A=[.5,.88],ts=(175-k)*.35*r,K=add(A,D(ts),.2),H=add(K,D(ts-(Math.PI-k*r)),.2),S=add(H,D(lean*r),.28),E=add(S,[0,1],.15),W=add(E,D(e*r),.14);
 const lm=Array.from({length:33},()=>({x:S[0],y:S[1]-.06,visibility:1}));
 [[11,12,S],[13,14,E],[15,16,W],[23,24,H],[25,26,K],[27,28,A]].forEach(([a,b,p])=>{lm[a]={x:p[0],y:p[1],visibility:1};lm[b]={x:p[0],y:p[1],visibility:1}});
 return lm}

function reset(){buf=[];lock=null;cand=null;reps=0;sets=0;phase=0;lastRom=null;rk=[];st='idle';lastKey='';fb('ابدأ التمرين وسأحلل حركتك.');ui()}
function stop(){mode=null;if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}}
function demo(){stop();reset();mode='demo';cv.style.transform='';$('ov').hidden=true;
 const t0=performance.now();(function lp(){if(mode!=='demo')return;const t=performance.now()-t0,lm=demoLM(t);draw(lm,null);proc(lm,1,t);requestAnimationFrame(lp)})()}
async function live(){
 stop();reset();$('ov').hidden=false;$('ov').textContent='جارٍ تشغيل الكاميرا…';
 try{stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:640,height:480},audio:false});vd.srcObject=stream;await vd.play()}
 catch(e){$('ov').textContent='تعذّر الوصول للكاميرا. اسمح بالإذن من إعدادات المتصفح، أو افتح الصفحة في نافذة مستقلة، أو جرّب الوضع التجريبي.';return}
 if(!window.Pose){$('ov').textContent='تعذّر تحميل نموذج تتبّع الجسم. تحقق من الاتصال أو جرّب الوضع التجريبي.';return}
 mode='live';cv.style.transform='scaleX(-1)';let got=false;
 try{pose=new Pose({locateFile:f=>'https://cdn.jsdelivr.net/npm/@mediapipe/pose@0.5.1675469404/'+f});
 pose.setOptions({modelComplexity:1,smoothLandmarks:true,minDetectionConfidence:.5,minTrackingConfidence:.5});
 pose.onResults(r=>{if(!got){got=true;$('ov').hidden=true}draw(r.poseLandmarks,vd);if(r.poseLandmarks)proc(r.poseLandmarks,vd.videoWidth/vd.videoHeight,performance.now());else{fb('لا يظهر جسم في الصورة','w')}});
 setTimeout(()=>{if(!got&&mode==='live'){$('ov').hidden=false;$('ov').textContent='النموذج لم يبدأ. قد تكون الشبكة تحجب ملفاته؛ جرّب الوضع التجريبي أو شغّل الصفحة في بيئة تسمح بتحميله.'}},25000);
 (async function lp(){if(mode!=='live')return;try{if(vd.readyState>=2)await pose.send({image:vd})}catch(e){}requestAnimationFrame(lp)})()}
 catch(e){$('ov').textContent='حدث خطأ أثناء تشغيل النموذج.'}}
$('bc').onclick=live;$('bd').onclick=demo;$('br').onclick=reset;ui();
</script></body></html>
